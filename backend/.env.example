PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=jegamart_db
JWT_SECRET=your_jwt_secret_key

# Optional: Google Gemini AI API Configuration for Chatbot
# If left unset or with placeholder, the chatbot automatically uses the built-in catalog-grounded store engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
